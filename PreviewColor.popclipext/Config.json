{
	"name": "Preview Color",
	"identifier": "com.github.mohaka.popclip.extension.color-preview",
	"description": "Show a swatch of the selected CSS or platform color. Hover it for buttons that copy the color in other formats; Option-click a button to replace the color in place.",
	"icon": "symbol:paintpalette",
	"module": "color.js",
	"entitlements": ["dynamic"],
	"options": [
		{ "identifier": "webHeading", "type": "heading", "label": "Web Formats" },
		{ "identifier": "name", "type": "boolean", "label": "Name", "icon": "symbol:textformat", "defaultValue": true },
		{ "identifier": "tailwind", "type": "boolean", "label": "Tailwind", "icon": "symbol:wind", "defaultValue": false },
		{ "identifier": "hex", "type": "boolean", "label": "Hex", "icon": "symbol:number", "defaultValue": true },
		{ "identifier": "rgb", "type": "boolean", "label": "RGB", "icon": "RGB", "defaultValue": true },
		{ "identifier": "hsl", "type": "boolean", "label": "HSL", "icon": "HSL", "defaultValue": false },
		{ "identifier": "oklch", "type": "boolean", "label": "OKLCH", "icon": "LCH", "defaultValue": false },

		{ "identifier": "appHeading", "type": "heading", "label": "App Formats" },
		{ "identifier": "flutter", "type": "boolean", "label": "Flutter / Compose", "icon": "symbol:curlybraces", "defaultValue": false },
		{
			"identifier": "androidXml",
			"type": "boolean",
			"label": "Android XML",
			"icon": "symbol:chevron.left.forwardslash.chevron.right",
			"defaultValue": false
		},
		{ "identifier": "swiftUI", "type": "boolean", "label": "SwiftUI", "icon": "symbol:swift", "defaultValue": false },
		{ "identifier": "uiKit", "type": "boolean", "label": "UIKit", "icon": "symbol:iphone", "defaultValue": false },

		{ "identifier": "extrasHeading", "type": "heading", "label": "Extras" },
		{ "identifier": "contrast", "type": "boolean", "label": "Contrast", "icon": "symbol:circle.lefthalf.filled", "defaultValue": false },
		{ "identifier": "shades", "type": "boolean", "label": "Shades", "icon": "symbol:square.stack", "defaultValue": false },

		{ "identifier": "displayHeading", "type": "heading", "label": "Display" },
		{
			"identifier": "syntax",
			"type": "multiple",
			"label": "Syntax",
			"values": ["modern", "comma"],
			"valueLabels": ["Modern  rgb(255 0 0)", "Comma  rgb(255, 0, 0)"],
			"inset": true
		},
		{
			"identifier": "names",
			"type": "multiple",
			"label": "Names",
			"values": ["css", "list"],
			"valueLabels": ["CSS names first", "Color list only"],
			"inset": true
		},
		{ "identifier": "showSelected", "type": "boolean", "label": "Repeat the selected format", "defaultValue": false },
		{ "identifier": "gamut", "type": "boolean", "label": "Mark colors outside sRGB", "defaultValue": true },

		{ "identifier": "recognizeHeading", "type": "heading", "label": "Recognize" },
		{ "identifier": "cssDeclarations", "type": "boolean", "label": "CSS declarations — color: red;", "defaultValue": false },
		{ "identifier": "bareHex", "type": "boolean", "label": "Hex without # — 1f9add", "defaultValue": false },
		{ "identifier": "bareRgb", "type": "boolean", "label": "RGB without rgb() — 0, 128, 255", "defaultValue": false },
		{ "identifier": "platformCode", "type": "boolean", "label": "Platform code — Color(0xFF1F9ADD)", "defaultValue": true },
		{ "identifier": "tailwindClasses", "type": "boolean", "label": "Tailwind classes — bg-sky-500", "defaultValue": true },
		{
			"identifier": "multiple",
			"type": "boolean",
			"label": "Several colors in one selection",
			"description": "One swatch per color, up to 6.",
			"defaultValue": false
		}
	]
}
